FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    wget curl ca-certificates git make autoconf automake libtool pkg-config \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Default command overridden by docker-compose to keep container running
CMD ["sleep", "infinity"]
